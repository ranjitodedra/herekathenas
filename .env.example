# Environment for Here Kathenas

# Supabase (local or hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt for phone hashing (change in production / Zerops)
PHONE_HASH_PEPPER=dev-pepper-change-me

# Public app URL (Zerops). Prevents auth redirects to http://0.0.0.0:3000
# NEXT_PUBLIC_APP_URL=https://app-211-3000.ny1.zerops.app

# Set these on the Zerops `app` service before deploy:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, PHONE_HASH_PEPPER, NEXT_PUBLIC_APP_URL
