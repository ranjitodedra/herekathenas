# Environment for Here Kathenas

# Supabase (local or hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt for phone hashing (change in production / Zerops)
PHONE_HASH_PEPPER=dev-pepper-change-me

# Set the same four variables on the Zerops `app` service before deploy.
